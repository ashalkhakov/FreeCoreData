<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="BLd-el-Gt1" id="BLd-cn-001"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="BLd-el-Gt1" customClass="BLAppDelegate"/>
        <menu title="Main Menu" systemMenu="main" id="BLm-mn-001">
            <items>
                <menuItem title="Bulletin" id="BLm-mi-001">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Bulletin" systemMenu="apple" id="BLm-mn-002">
                        <items>
                            <menuItem title="About Bulletin" id="BLm-mi-002">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="orderFrontStandardAboutPanel:" target="-1" id="BLm-ac-001"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="BLm-mi-003"/>
                            <menuItem title="Hide Bulletin" keyEquivalent="h" id="BLm-mi-004">
                                <connections>
                                    <action selector="hide:" target="-1" id="BLm-ac-002"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="BLm-mi-005">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections>
                                    <action selector="hideOtherApplications:" target="-1" id="BLm-ac-003"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Show All" id="BLm-mi-006">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections>
                                    <action selector="unhideAllApplications:" target="-1" id="BLm-ac-004"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="BLm-mi-007"/>
                            <menuItem title="Quit Bulletin" keyEquivalent="q" id="BLm-mi-008">
                                <connections>
                                    <action selector="terminate:" target="-1" id="BLm-ac-005"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="BLm-mi-010">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Edit" id="BLm-mn-003">
                        <items>
                            <menuItem title="Cut" keyEquivalent="x" id="BLm-mi-011">
                                <connections>
                                    <action selector="cut:" target="-1" id="BLm-ac-006"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="BLm-mi-012">
                                <connections>
                                    <action selector="copy:" target="-1" id="BLm-ac-007"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="BLm-mi-013">
                                <connections>
                                    <action selector="paste:" target="-1" id="BLm-ac-008"/>
                                </connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="BLm-mi-014"/>
                            <menuItem title="Select All" keyEquivalent="a" id="BLm-mi-015">
                                <connections>
                                    <action selector="selectAll:" target="-1" id="BLm-ac-009"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="History" id="BLm-mi-020">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="History" id="BLm-mn-004">
                        <items>
                            <menuItem title="Refresh History" keyEquivalent="r" id="BLm-mi-021">
                                <connections>
                                    <action selector="refresh:" target="-1" id="BLm-ac-010"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Compact History" keyEquivalent="k" id="BLm-mi-022">
                                <connections>
                                    <action selector="compactHistory:" target="-1" id="BLm-ac-011"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="BLm-mi-030">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="BLm-mn-005">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="BLm-mi-031">
                                <connections>
                                    <action selector="performMiniaturize:" target="-1" id="BLm-ac-012"/>
                                </connections>
                            </menuItem>
                            <menuItem title="Close" keyEquivalent="w" id="BLm-mi-032">
                                <connections>
                                    <action selector="performClose:" target="-1" id="BLm-ac-013"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
