<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="MBUMappingEditorViewController">
            <connections>
                <outlet property="view" destination="mbup-vw-000" id="mbup-co-001" />
                <outlet property="split" destination="mbup-sp-000" id="mbup-co-002" />
                <outlet property="sourceListHost" destination="mbup-hs-001" id="mbup-co-003" />
                <outlet property="detailHost" destination="mbup-hs-002" id="mbup-co-004" />
                <outlet property="problemView" destination="mbup-pv-000" id="mbup-co-005" />
                <outlet property="problemLabel" destination="mbup-pl-000" id="mbup-co-006" />
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <!-- A mapping model's tab: the entity mappings and the selected one's property mappings (MBUMappingEditorViewController) -->
        <customView id="mbup-vw-000" customClass="MBUEditorView">
            <rect key="frame" x="0.0" y="0.0" width="760" height="560" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <subviews>
                <splitView fixedFrame="YES" arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" translatesAutoresizingMaskIntoConstraints="NO" id="mbup-sp-000">
                    <rect key="frame" x="0.0" y="0.0" width="760" height="560" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                    <subviews>
                        <customView fixedFrame="YES" id="mbup-hs-001" userLabel="sourceListHost">
                            <rect key="frame" x="0.0" y="0.0" width="220" height="560" />
                            <autoresizingMask key="autoresizingMask" heightSizable="YES" />
                        </customView>
                        <customView fixedFrame="YES" id="mbup-hs-002" userLabel="detailHost">
                            <rect key="frame" x="221" y="0.0" width="539" height="560" />
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        </customView>
                    </subviews>
                    <holdingPriorities>
                        <real value="260" />
                        <real value="250" />
                    </holdingPriorities>
                    <connections>
                        <outlet property="delegate" destination="-2" id="mbup-sp-001" />
                    </connections>
                </splitView>
                <customView hidden="YES" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="mbup-pv-000" userLabel="problemView">
                    <rect key="frame" x="0.0" y="0.0" width="760" height="560" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                    <subviews>
                        <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="mbup-pl-000">
                            <rect key="frame" x="40" y="300" width="680" height="60" />
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" flexibleMaxY="YES" />
                            <textFieldCell key="cell" lineBreakMode="charWrapping" selectable="YES" alignment="center" title="" id="mbup-pl-001">
                                <font key="font" metaFont="system" />
                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog" />
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                            </textFieldCell>
                        </textField>
                        <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="mbup-pb-000">
                            <rect key="frame" x="315" y="250" width="130" height="32" />
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES" />
                            <buttonCell key="cell" type="push" title="Show as Text" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="mbup-pb-001">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                                <font key="font" metaFont="system" />
                            </buttonCell>
                            <connections>
                                <action selector="showAsText:" target="-2" id="mbup-pb-002" />
                            </connections>
                        </button>
                    </subviews>
                </customView>
            </subviews>
            <connections>
                <outlet property="controller" destination="-2" id="mbup-vw-001" />
            </connections>
        </customView>
    </objects>
</document>
