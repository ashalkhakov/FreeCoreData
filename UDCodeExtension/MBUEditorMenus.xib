<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23504" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23504" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSObject" />
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <!-- The Editor menu's items (MBUExtension's -editorMenuItemsForWorkbench:): to the
             first responder, which in a model's or a mapping's tab is its editor -->
        <menu title="Core Data" id="mbmn-root">
            <items>
                <menuItem title="Add Entity" id="mbmn-000">
                    <connections>
                        <action selector="addEntity:" target="-1" id="mbma-000" />
                    </connections>
                </menuItem>
                <menuItem title="Add Attribute" id="mbmn-001">
                    <connections>
                        <action selector="addAttribute:" target="-1" id="mbma-001" />
                    </connections>
                </menuItem>
                <menuItem title="Add Relationship" id="mbmn-002">
                    <connections>
                        <action selector="addRelationship:" target="-1" id="mbma-002" />
                    </connections>
                </menuItem>
                <menuItem title="Add Fetch Request" id="mbmn-003">
                    <connections>
                        <action selector="addFetchRequest:" target="-1" id="mbma-003" />
                    </connections>
                </menuItem>
                <menuItem title="Add Configuration" id="mbmn-004">
                    <connections>
                        <action selector="addConfiguration:" target="-1" id="mbma-004" />
                    </connections>
                </menuItem>
                <menuItem title="Add Fetch Index" id="mbmn-005">
                    <connections>
                        <action selector="addFetchIndex:" target="-1" id="mbma-005" />
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="mbmn-006" />
                <menuItem title="Remove Entity" id="mbmn-007">
                    <connections>
                        <action selector="removeEntity:" target="-1" id="mbma-007" />
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="mbmn-008" />
                <menuItem title="Validate Model" id="mbmn-009">
                    <connections>
                        <action selector="validateModel:" target="-1" id="mbma-009" />
                    </connections>
                </menuItem>
                <menuItem title="Create NSManagedObject Subclass…" id="mbmn-010">
                    <connections>
                        <action selector="createManagedObjectSubclass:" target="-1" id="mbma-010" />
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="mbmn-011" />
                <menuItem title="Add Entity Mapping" id="mbmn-012">
                    <connections>
                        <action selector="addEntityMapping:" target="-1" id="mbma-012" />
                    </connections>
                </menuItem>
                <menuItem title="Remove Entity Mapping" id="mbmn-013">
                    <connections>
                        <action selector="removeEntityMapping:" target="-1" id="mbma-013" />
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="mbmn-014" />
                <menuItem title="Show as Text" id="mbmn-015">
                    <connections>
                        <action selector="showAsText:" target="-1" id="mbma-015" />
                    </connections>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
