# What FreeCoreData builds on, by exact versions, the one place each is named:
# the GNUstep stack (a release of ashalkhakov/gnustep-patches), Sparkle (Model
# Builder on macOS) and UDCode's SDK (the Core Data extension).
# gnustep-release-actions fetches them (scripts/deps.sh); to move one, change
# it here.
GNUSTEP_PATCHES_VERSION=2026.10.20.40
SPARKLE_VERSION=2.10.0
# UDCode's SDK (ashalkhakov/UDCodeKit's udcodekit archives): what UDCode's Core
# Data extension builds on (UDCodeExtension/).
UDCODEKIT_VERSION=0.19.2
# What UDCode's SDK links on Windows, and so the installer's closure needs: the
# DiagramKit that UDCode release carries (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
