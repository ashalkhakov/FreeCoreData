# What FreeCoreData builds on, by exact versions, the one place each is named:
# the GNUstep stack (a release of ashalkhakov/gnustep-patches) and Sparkle
# (Model Builder on macOS). gnustep-release-actions fetches them
# (scripts/deps.sh); to move one, change it here.
GNUSTEP_PATCHES_VERSION=2026.10.20.14
SPARKLE_VERSION=2.10.0
